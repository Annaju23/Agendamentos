<button @onclick="OnClick" disabled="@Disabled">
 @Text
</button>

@code {
    [Parameter]// anotação
    public string? Text { get; set; } //propriedade - é uma informação de uma classe
    [Parameter]
    public bool Disabled { get; set; } = false; //
    [Parameter]
    public EventCallback OnClick { get; set;}

}
